{
  "manifest_version": 3,
  "name": "Antigravity 控制中心 · MCP & Skills",
  "version": "1.0.0",
  "description": "在 Chrome / Edge 侧边栏中管理 Antigravity MCP 服务器与 Skill 仓库：支持零后端对话桥接（开箱即用）与直连后端双模式。",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "打开 Antigravity MCP & Skills 侧边栏",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
